# Database (Prisma). Use a Postgres connection string.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/dokumen?sslmode=require"
# Optional fallbacks used by packages/db:
# PRISMA_DATABASE_URL=
# POSTGRES_URL=

# HTTP server
BACKEND_PORT=4000

# Auth / JWT
# Use a strong random secret of at least 16 characters (do not reuse any
# example value from this file in production).
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_RESET_EXPIRES_IN="15m"

# CORS allowlist (comma-separated). Required in production.
# CORS_ORIGINS="http://localhost:5173"