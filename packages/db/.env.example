# Prisma ORM connection strings (PostgreSQL)
# Fill these in with your own database credentials.
# The shared client in packages/db/src/index.ts resolves the URL in this order:
# DATABASE_URL > PRISMA_DATABASE_URL > POSTGRES_URL

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"